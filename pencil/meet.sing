// Lines of G_s meeting the line z0=z3=0, s a free variable (all members at once). Line = span(p,q), p on z0=z3=0, q in a complementary plane.
LIB "primdec.lib";
ring R = 0, (t,e,f,s,m), dp;
proc go(list p, list q, string nm)
{
 poly z0=m*p[1]+q[1]; poly z1=m*p[2]+q[2]; poly z2=m*p[3]+q[3]; poly z3=m*p[4]+q[4];
 poly G=4*z0^3*z3 - 4*z0*z3^3 + 2*z1*z2*(s*(z0^2+z3^2) - (z1^2+z2^2));
 matrix C=coeffs(G,m); ideal I=C[1..nrows(C),1]; 
 list L=minAssGTZ(I); int i; nm, ": components", size(L);
 for(i=1;i<=size(L);i++){ "  comp",i,"dim",dim(std(L[i])); L[i]; }
}
go(list(0,1,t,0), list(1,0,e,f), "p=(0,1,t,0), q=(1,0,e,f)");
go(list(0,1,t,0), list(0,0,e,1), "p=(0,1,t,0), q=(0,0,e,1)");
go(list(0,0,1,0), list(1,e,0,f), "p=(0,0,1,0), q=(1,e,0,f)   [t unused]");
go(list(0,0,1,0), list(0,e,0,1), "p=(0,0,1,0), q=(0,e,0,1)   [t,f unused]");
quit;

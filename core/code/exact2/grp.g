G:=Group(elts);;
Print("order ",Size(G),"\n");
Print("IdGroup ",IdGroup(G),"\n");
Print("StructureDescription ",StructureDescription(G),"\n");
Print("exponent ",Exponent(G),"\n");
Print("center ",StructureDescription(Centre(G)),"\n");
Print("derived ",StructureDescription(DerivedSubgroup(G)),"\n");
Print("abelianisation ",StructureDescription(G/DerivedSubgroup(G)),"\n");
Print("element orders ",Collected(List(Elements(G),Order)),"\n");
Print("nilpotency class ",NilpotencyClassOfGroup(G),"\n");
Print("conj classes ",Length(ConjugacyClasses(G)),"\n");
Print("subgroups by order ",Collected(List(ConjugacyClassesSubgroups(G),c->Size(Representative(c))*0+Size(Representative(c)))),"\n");
L:=Concatenation(List(ConjugacyClassesSubgroups(G),Elements));;
Print("subgroup counts by order ",Collected(List(L,Size)),"\n");
Print("Frattini ",StructureDescription(FrattiniSubgroup(G)),"\n");
Print("minimal gens ",Length(MinimalGeneratingSet(G)),"\n");
Print("faithful irreps degrees ",Collected(List(Irr(G),x->x[1])),"\n");
Print("SmallGroup(32,k) with same invariants: ");
Print(Filtered([1..51],k->Collected(List(Elements(SmallGroup(32,k)),Order))=Collected(List(Elements(G),Order)) and Size(Centre(SmallGroup(32,k)))=Size(Centre(G)) and Size(DerivedSubgroup(SmallGroup(32,k)))=Size(DerivedSubgroup(G))),"\n");
Print("IsomorphismGroups check: ",IsomorphismGroups(G,SmallGroup(IdGroup(G)[1],IdGroup(G)[2]))<>fail,"\n");

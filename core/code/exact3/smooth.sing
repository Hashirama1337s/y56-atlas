// Smoothness of Y56: singular locus ideal (dF/dz_i) has only the origin as affine-cone zero.
ring R=(0,s),(z0,z1,z2,z3),dp; minpoly=s^2-2;
poly F=3*s*z0^2*z1*z2+3*s*z1*z2*z3^2-s*z1^3*z2-s*z1*z2^3+4*z0^3*z3-4*z0*z3^3;
ideal J=diff(F,z0),diff(F,z1),diff(F,z2),diff(F,z3);
ideal G=std(J);
"dim of affine cone of singular locus (0 = only origin, i.e. projectively empty):",dim(G);
"vdim of R/J:",vdim(G);
int i; for(i=1;i<=4;i++){ "power of z"+string(i-1)+" in leading ideal of J:"; } 
// F in J (Euler): 
"reduce(F,G) =",reduce(F,G);
// each variable has a pure power in lead(G)
for(i=1;i<=4;i++){ int k=1; while(reduce(var(i)^k,G)!=0){k++;} "z"+string(i-1)+"^"+string(k)+" in J"; kill k; }
// dehomogenized charts z_i=1: J + (z_i-1) must be unit ideal

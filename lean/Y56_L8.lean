theorem rel_rows_12 : (List.range' 48 4).all relRow = true := by decide +kernel
theorem rel_rows_13 : (List.range' 52 4).all relRow = true := by decide +kernel
theorem rel_rows : ∀ i, i < 56 → relRow i = true :=
  forall_of_chunks relRow 4 14 (by norm_num) (fun c hc => match c, hc with
    | 0, _ => rel_rows_0
    | 1, _ => rel_rows_1
    | 2, _ => rel_rows_2
    | 3, _ => rel_rows_3
    | 4, _ => rel_rows_4
    | 5, _ => rel_rows_5
    | 6, _ => rel_rows_6
    | 7, _ => rel_rows_7
    | 8, _ => rel_rows_8
    | 9, _ => rel_rows_9
    | 10, _ => rel_rows_10
    | 11, _ => rel_rows_11
    | 12, _ => rel_rows_12
    | 13, _ => rel_rows_13
    | _ + 14, h => absurd h (by omega))


/-- **L8b.** Every row of G is an integer combination of the 20 basis rows. -/
theorem rows_in_span (j : Nat) (hj : j < 56) (m : Nat) :
    Gf j m = ((List.range 20).map fun a => coef j a * Gf (BASIS.getD a 0) m).sum ∨ 56 ≤ m := by
  by_cases hm : m < 56
  · left
    have h := rel_rows j hj
    simp only [relRow, Bool.or_eq_true, decide_eq_true_eq, show ¬ (j ≥ 56) from by omega, false_or] at h
    have := List.all_eq_true.mp h m (List.mem_range.mpr hm)
    simpa using this
  · right; omega

/-- **L8c.** For the four-line plane with lines [0, 6, 23, 24]: h = their sum has h.h = 4, and h.L = 1 for every
line L (each line meets the plane section once). -/
theorem hyperplane_class :
    (([0, 6, 23, 24].map fun a => ([0, 6, 23, 24].map fun b => Gf a b).sum).sum = 4) ∧
    (List.range 56).all (fun j => ([0, 6, 23, 24].map fun a => Gf a j).sum == 1) = true := by
  decide +kernel

end Y56

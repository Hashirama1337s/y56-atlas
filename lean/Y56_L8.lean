def coef (j a : Nat) : Int := (COEF.getD j []).getD a 0

def relRow (j : Nat) : Bool :=
  j ≥ 56 || (List.range 56).all fun m =>
    Gf j m == ((List.range 20).map fun a => coef j a * Gf (BASIS.getD a 0) m).sum

theorem rel_rows_0 : (List.range' 0 4).all relRow = true := by decide +kernel
theorem rel_rows_1 : (List.range' 4 4).all relRow = true := by decide +kernel
theorem rel_rows_2 : (List.range' 8 4).all relRow = true := by decide +kernel
theorem rel_rows_3 : (List.range' 12 4).all relRow = true := by decide +kernel
theorem rel_rows_4 : (List.range' 16 4).all relRow = true := by decide +kernel
theorem rel_rows_5 : (List.range' 20 4).all relRow = true := by decide +kernel
theorem rel_rows_6 : (List.range' 24 4).all relRow = true := by decide +kernel

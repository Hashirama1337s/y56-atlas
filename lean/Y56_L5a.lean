    1 * F s (s * x + s * y - s * w + x + y - w) (x) (y) (w)
      = (1) * (-s * x - 2 * y + 2 * w) * (-s * y - 2 * x + 2 * w) * conicEval s hs cqP2_000_0 x y w := by
  simp only [conicEval, cqP2_000_0, List.getD_cons_zero, List.getD_cons_succ, iota_q]

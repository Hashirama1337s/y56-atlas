// Round 2, task 1: Fano scheme of lines of the wall quartic W (rational coefficients), after a random rational change z = T w.
LIB "primdec.lib";
ring R = 0, (a,b,c,d,m), dp;
matrix T[4][4] = 2,-1,3,1, 1,2,-2,3, -3,1,1,2, 1,3,2,-1;
proc chart(int i,int j)
{
 int k; int l; int t; list ot; for(t=0;t<=3;t++){ if(t!=i && t!=j){ ot=ot+list(t);} }
 k=ot[1]; l=ot[2]; list p=0,0,0,0; list q=0,0,0,0;
 p[i+1]=1; p[k+1]=a; p[l+1]=b; q[j+1]=1; q[k+1]=c; q[l+1]=d;
 list w; for(t=1;t<=4;t++){ w[t]=m*p[t]+q[t]; }
 poly z0=T[1,1]*w[1]+T[1,2]*w[2]+T[1,3]*w[3]+T[1,4]*w[4];
 poly z1=T[2,1]*w[1]+T[2,2]*w[2]+T[2,3]*w[3]+T[2,4]*w[4];
 poly z2=T[3,1]*w[1]+T[3,2]*w[2]+T[3,3]*w[3]+T[3,4]*w[4];
 poly z3=T[4,1]*w[1]+T[4,2]*w[2]+T[4,3]*w[3]+T[4,4]*w[4];
 poly G=4*z0^3*z3 - 4*z0*z3^3 + 4*z1*z2*(z0^2+z3^2) - 2*z1*z2*(z1^2+z2^2);
 matrix C=coeffs(G,m); ideal I=C[1,1],C[2,1],C[3,1],C[4,1],C[5,1];
 list pl; int u; int v; for(u=1;u<=3;u++){ for(v=u+1;v<=4;v++){ pl=pl+list(p[u]*q[v]-p[v]*q[u]); }}
 return(list(I,pl));
}
"det T ="; det(T);
int i; int j; int n=0; list r; ideal Ic; ideal G; ideal Gr; int tot=0; int totr=0;
for(i=0;i<=2;i++){ for(j=i+1;j<=3;j++){
  r=chart(i,j); Ic=r[1]+ideal(m); int t;
  for(t=1;t<=n;t++){ Ic=Ic+ideal(r[2][t]); }
  G=std(Ic);
  if (G[1]==1) { "chart",i,j,": empty (after removing earlier charts)"; }
  else { Gr=std(radical(Ic)); "chart",i,j,": dim",dim(G)," vdim",vdim(G)," distinct",vdim(Gr); tot=tot+vdim(G); totr=totr+vdim(Gr); }
  n=n+1; kill t;
}}
"TOTAL lines with multiplicity:",tot,"  distinct lines:",totr;
quit;
